rules_version = '2';

// ============================================================
//  Firestore 보안 규칙
//  "로그인한 사람은 자기 문서(users/자기uid)만 읽고 쓸 수 있다"
//  → 남의 기록은 절대 볼 수 없고, 로그인 안 하면 아무것도 못 읽습니다.
//
//  Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에
//  아래 내용을 그대로 붙여넣고 [게시]를 누르세요.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // 그 외 모든 경로는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
